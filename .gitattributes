# ============================================================
#  换行符策略 —— 让所有文件的换行符永远一致
#
#  背景：Windows 用 CRLF（\r\n），Linux 用 LF（\n）。
#  不统一的话，git 每次都会报 "LF will be replaced by CRLF"，
#  而且以后 diff 会满屏红色、合并容易冲突。
#
#  策略：
#    - 仓库里统一存 LF（C 语言工程的标准做法，Linux/gcc 友好）
#    - 检出到 Windows 工作区时自动转成 CRLF（normalize 的默认行为）
#    - .cmd 批处理例外，必须 CRLF（见下方说明）
# ============================================================

# 默认：自动判断文本文件，统一按 LF 存进仓库
* text=auto

# ---------- 强制用 LF 的文件类型 ----------
*.c        text eol=lf
*.h        text eol=lf
*.md       text eol=lf
*.ps1      text eol=lf
*.py       text eol=lf
*.mk       text eol=lf
Makefile   text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.txt      text eol=lf
.gitignore text eol=lf

# ---------- 强制用 CRLF 的文件类型 ----------
# Windows 批处理必须 CRLF：cmd.exe 用 LF 解析 if/for 多行块会出错
*.cmd      text eol=crlf
*.bat      text eol=crlf

# ---------- 二进制文件，git 不要碰 ----------
*.exe      binary
*.o        binary
*.a        binary
*.dll      binary
*.hex      binary
*.bin      binary
*.elf      binary
*.png      binary
*.jpg      binary
*.ico      binary
*.pdf      binary
